{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-backend",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-sql","database_id": "2ca75387-775f-4aed-85ab-ab610de57541"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media"
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
"vars": {
    "EMDASH_SITE_URL": "https://emdash-backend.jobsqiao861.workers.dev/"
  }
}
